//                                       
//                ▄▄▄     ▄▄▄            
//         █▄   ▄██▀▀▀  ▄██▀▀▀           
//         ██   ██ ▄▀█▄ ██ ▄▀█▄ ▄▄      
//   ▀▀▀██ ████▄██   ██ ██   ██ ██ ▄█▀  
//     ▄█▀ ██ ████  ▄██ ██  ▄██ ████    
//  ▄▄██▄▄ █  ██ ▀███▀   ▀███▀ ▄██ ▀█▄  
//                                      
//  ==================================
//  zh00k config: https://github.com/zh00k/dotfiles                                   
//  ==================================
//


prefer-no-csd

input {
    keyboard {
        xkb {
            layout "us,ru"
	    options "compose:ralt,ctrl:nocaps"
        }
    }

    touchpad {
        tap
        dwt
        drag true
        drag-lock
        natural-scroll
        click-method "clickfinger"
        accel-speed 0.8
        scroll-factor 0.7
        scroll-method "two-finger"
        middle-emulation
    }

    mouse { }

    focus-follows-mouse max-scroll-amount="0%"
}

layout {
    gaps 16
    center-focused-column "never"
    background-color "transparent"

    border { off; }

    struts {  }

    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    } 

    focus-ring {
        width 2
        active-color "#707070"
        inactive-color "#505050"
    }

    shadow { 
        on
        softness 20
        spread 3
        offset x=0 y=0
        draw-behind-window true
        color "#00000090"
    }
}

// Autostart
spawn-at-startup "waybar"
spawn-at-startup "swaybg" "-i" "/home/zh00k/Pictures/Wallpapers/wallpaper.png" "-m" "fill"
spawn-at-startup "sh" "-c" "sleep 2 && /usr/local/bin/amnezia-launcher"
spawn-at-startup "eww" "daemon"

overview {
    zoom 0.8
    workspace-shadow { off; }
}

// Wallpaper within overview fix 
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

// Amnezia VPN
window-rule {
    match title="Xwayland on :0"
    open-floating true
    open-on-workspace "5"

    max-height 680
    max-width 380
}

hotkey-overlay {
    skip-at-startup
}

environment {
    QT_QPA_PLATFORM "wayland"
    GTK_THEME "Colloid-Grey-Dark-Compact"
    DISPLAY null
}

cursor {
    xcursor-theme "Noir"
    xcursor-size 26 
    hide-when-typing
}

clipboard {
    disable-primary
}

animations { }

// Block out from screen capture
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"
}

// Round corners
window-rule {
    geometry-corner-radius 6 
    clip-to-geometry true 
}

// Satty (screenshot)
window-rule {
    match app-id="satty"
    open-floating true
}


workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"


binds {
    Mod+Return { spawn "alacritty"; }
    Mod+Space { spawn "fuzzel"; }
    Mod+Shift+S { spawn-sh "grim -t ppm -g \"$(slurp -d)\" - | satty -f - --initial-tool=highlight --copy-command=wl-copy --actions-on-escape=\"save-to-clipboard,exit\" --brush-smooth-history-size=5 --disable-notifications --no-window-decoration"; }

    // Закрыть окно
    Mod+Escape { close-window; }

    Ctrl+Space { switch-layout "next"; }

    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }

    Mod+Shift+E { quit; }

    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }

    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+M { maximize-window-to-edges; }

    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+C { center-column; }

    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    Mod+W { toggle-column-tabbed-display; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Shift+P { power-off-monitors; }
}
